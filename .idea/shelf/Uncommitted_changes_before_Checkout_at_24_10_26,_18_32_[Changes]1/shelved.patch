-    public BigDecimal discountAmount() {
-        return customer.discountOn(subtotal());
-    }
-
-    public BigDecimal taxAmount() {
-        return taxPolicy.taxOn(subtotal().subtract(discountAmount()));
-    }
-
-    public BigDecimal finalAmount() {
