classDiagram
direction TB
class Ticket {
  <<interface>>
  +getDescription() String
  +getPrice() double
}
class BasicTicket {
  -flightNumber String
  -passengerName String
  -basePrice double
  +BasicTicket(String flightNumber, String passengerName, double basePrice)
  +getDescription() String
  +getPrice() double
}
class TicketDecorator {
  <<abstract>>
  -wrapped Ticket
  -serviceName String
  -surcharge double
  #TicketDecorator(Ticket wrapped, String serviceName, double surcharge)
  +getDescription() String
  +getPrice() double
}
class ExtraBaggage {
  +ExtraBaggage(Ticket wrapped)
}
class SeatSelection {
  +SeatSelection(Ticket wrapped)
}
class PriorityBoarding {
  +PriorityBoarding(Ticket wrapped)
}
class Insurance {
  +Insurance(Ticket wrapped)
}
class Meal {
  +Meal(Ticket wrapped)
}
class Log {
  <<utility>>
  -seconds$ int
  +log(String source, String event)$ void
  +logf(String source, String format, Object... args)$ void
}
