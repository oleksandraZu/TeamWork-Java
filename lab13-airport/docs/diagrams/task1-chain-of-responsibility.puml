@startuml task1-chain-of-responsibility
title Завдання 1. Chain of Responsibility — передпольотний контроль пасажира (Аеропорт «Буковина»)
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

class PreflightControlService <<Client>> {
  - {static} SOURCE : String
  - chains : Map<FlightType, ControlHandler>
  + configureChain(type : FlightType, handlers : ControlHandler...) : void
  + process(passenger : Passenger) : ControlResult
}

abstract class ControlHandler <<Handler>> {
  - next : ControlHandler
  + setNext(next : ControlHandler) : ControlHandler
  + {final} handle(passenger : Passenger) : ControlResult
  # {abstract} check(passenger : Passenger) : String
  + {abstract} title() : String
}

class BoardingPassHandler <<ConcreteHandler>> {
  # check(passenger : Passenger) : String
  + title() : String
}

class PassportControlHandler <<ConcreteHandler>> {
  # check(passenger : Passenger) : String
  + title() : String
}

class SecurityScreeningHandler <<ConcreteHandler>> {
  # check(passenger : Passenger) : String
  + title() : String
}

class CarryOnWeightHandler <<ConcreteHandler>> {
  - maxWeightKg : double
  + CarryOnWeightHandler(maxWeightKg : double)
  # check(passenger : Passenger) : String
  + title() : String
}

class CustomsControlHandler <<ConcreteHandler>> {
  # check(passenger : Passenger) : String
  + title() : String
}

class Passenger <<record>> {
  - name : String
  - flightNumber : String
  - flightType : FlightType
  - boardingPassValid : boolean
  - passportValid : boolean
  - hasProhibitedItems : boolean
  - carryOnWeightKg : double
  - customsDeclarationOk : boolean
}

class ControlResult <<record>> {
  - passed : boolean
  - stoppedBy : String
  - reason : String
  + {static} ok() : ControlResult
  + {static} stopped(stoppedBy : String, reason : String) : ControlResult
}

enum FlightType {
  DOMESTIC
  INTERNATIONAL
  - title : String
  + getTitle() : String
}

BoardingPassHandler --|> ControlHandler
PassportControlHandler --|> ControlHandler
SecurityScreeningHandler --|> ControlHandler
CarryOnWeightHandler --|> ControlHandler
CustomsControlHandler --|> ControlHandler

ControlHandler "1" o--> "0..1" ControlHandler : next
PreflightControlService "1" o--> "1..*" ControlHandler : chains\n(початок ланцюга\nна тип рейсу)

PreflightControlService ..> Passenger : <<use>>
PreflightControlService ..> ControlResult : <<use>>
PreflightControlService ..> FlightType : <<use>>
ControlHandler ..> Passenger : <<use>>
ControlHandler ..> ControlResult : <<create>>
Passenger "1" --> "1" FlightType : flightType

note right of ControlHandler
  Роль: Handler (ланка ланцюга).
  Перевірка або зупиняє пасажира
  з причиною, або передає next.
end note
note bottom of CarryOnWeightHandler
  Роль: ConcreteHandler.
  Усі ConcreteHandler реалізують
  лише check() і title().
end note
note right of PreflightControlService
  Роль: Client. Збирає ланцюги
  під час виконання окремо для
  внутрішніх і міжнародних рейсів.
end note
@enduml
