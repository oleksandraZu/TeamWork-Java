@startuml task2-command
title Завдання 2. Command — операції диспетчера з розкладом (Аеропорт «Буковина»)
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

class Main <<Client>> {
  + {static} main(args : String[]) : void
  - {static} situation1PreflightControl() : void
  - {static} situation2DispatcherScheduleOperations() : void
}

class DispatcherConsole <<Invoker>> {
  - {static} SOURCE : String
  - dispatcherName : String
  - history : Deque<ScheduleCommand>
  - pending : Queue<ScheduleCommand>
  - journal : ActionJournal
  + DispatcherConsole(dispatcherName : String)
  + execute(command : ScheduleCommand) : void
  + enqueue(command : ScheduleCommand) : void
  + executePending() : void
  + undoLast() : void
  + getJournal() : ActionJournal
  - run(command : ScheduleCommand) : void
}

interface ScheduleCommand <<Command>> {
  + execute() : void
  + undo() : void
  + description() : String
}

class RescheduleFlightCommand <<ConcreteCommand>> {
  - {static} SOURCE : String
  - schedule : Schedule
  - flightNumber : String
  - newTime : LocalTime
  - oldTime : LocalTime
  + execute() : void
  + undo() : void
  + description() : String
}

class ChangeGateCommand <<ConcreteCommand>> {
  - {static} SOURCE : String
  - schedule : Schedule
  - flightNumber : String
  - newGate : String
  - oldGate : String
  + execute() : void
  + undo() : void
  + description() : String
}

class CancelFlightCommand <<ConcreteCommand>> {
  - {static} SOURCE : String
  - schedule : Schedule
  - flightNumber : String
  - wasCancelled : boolean
  - executed : boolean
  + execute() : void
  + undo() : void
  + description() : String
}

class Schedule <<Receiver>> {
  - {static} SOURCE : String
  - flights : Map<String, Flight>
  + addFlight(flight : Flight) : void
  - find(number : String) : Flight
  + reschedule(number : String, newTime : LocalTime) : LocalTime
  + changeGate(number : String, newGate : String) : String
  + setCancelled(number : String, cancelled : boolean) : boolean
  + print(title : String) : void
}

class Flight {
  - number : String
  - departure : LocalTime
  - gate : String
  - cancelled : boolean
  + getNumber() : String
  + getDeparture() : LocalTime
  + setDeparture(departure : LocalTime) : void
  + getGate() : String
  + setGate(gate : String) : void
  + isCancelled() : boolean
  + setCancelled(cancelled : boolean) : void
}

class ActionJournal {
  - {static} SOURCE : String
  - {static} FORMAT : DateTimeFormatter
  - entries : List<JournalEntry>
  + add(dispatcher : String, action : JournalAction, description : String) : void
  + print() : void
}

class JournalEntry <<record>> {
  - time : LocalTime
  - dispatcher : String
  - action : JournalAction
  - description : String
}

enum JournalAction {
  EXECUTED
  UNDONE
  - title : String
  + getTitle() : String
}

RescheduleFlightCommand ..|> ScheduleCommand
ChangeGateCommand ..|> ScheduleCommand
CancelFlightCommand ..|> ScheduleCommand

RescheduleFlightCommand "*" --> "1" Schedule : schedule
ChangeGateCommand "*" --> "1" Schedule : schedule
CancelFlightCommand "*" --> "1" Schedule : schedule

DispatcherConsole "1" o--> "0..*" ScheduleCommand : history\n(стек виконаних)
DispatcherConsole "1" o--> "0..*" ScheduleCommand : pending\n(черга відкладених)
DispatcherConsole "1" *--> "1" ActionJournal : journal

ActionJournal "1" *--> "0..*" JournalEntry : entries
JournalEntry "*" --> "1" JournalAction : action
Schedule "1" o--> "0..*" Flight : flights

Main ..> DispatcherConsole : <<create>>
Main ..> Schedule : <<create>>
Main ..> RescheduleFlightCommand : <<create>>
Main ..> ChangeGateCommand : <<create>>
Main ..> CancelFlightCommand : <<create>>

note right of ScheduleCommand
  Роль: Command. Кожна дія з розкладом
  знає, як виконатися і як скасуватися.
end note
note right of DispatcherConsole
  Роль: Invoker. Виконує, скасовує
  у зворотному порядку, накопичує
  в черзі й веде журнал дій.
end note
note bottom of Schedule
  Роль: Receiver. Фактично змінює розклад.
end note
@enduml
